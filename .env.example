# ====== 管理员认证 ======
# 管理员登录密码（GitHub Secret 注入，不入库）
ADMIN_PASSWORD=change-me-to-a-strong-password
# JWT 签名密钥（GitHub Secret 注入）
JWT_SECRET=change-me-to-a-long-random-string

# ====== 腾讯云 COS（仅服务端，不可泄露） ======
# Bucket 保持「私有读」，所有图片 URL 由服务端用 SecretKey 生成带时效签名。
# SecretId/SecretKey 获取：https://console.cloud.tencent.com/cam/capi
COS_SECRET_ID=your-tencent-secret-id
COS_SECRET_KEY=your-tencent-secret-key
COS_BUCKET=axello-1300112050
COS_REGION=ap-shanghai
# 图片访问域名（可选）：腾讯云 COS 自定义域名。
# - 自定义源站域名（如 img.axello.cn）：默认带签名（私有读 Bucket 可用）
# - CDN 加速域名（如 img-cdn.axello.cn）：必须设 COS_IMAGE_HOST_SIGNED=false，
#   CDN 域名不支持 COS 预签名（回源报 InvalidAccessKeyId），且回源鉴权由
#   COS 控制台配置域名时的服务授权承担；无签名 URL 缓存 key 稳定、命中率高
# 留空则走 COS 源站并带签名
COS_IMAGE_HOST=
# 图片访问域名是否带签名，默认 true；配 CDN 加速域名时设为 false
COS_IMAGE_HOST_SIGNED=true

# ====== 数据库 ======
# SQLite 文件路径（服务器上绝对路径）
DB_PATH=./data/flight-albums.db
